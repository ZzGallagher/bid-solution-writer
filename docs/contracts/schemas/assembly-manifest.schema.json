{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bid-solution-writer.local/schemas/assembly-manifest.schema.json",
  "title": "assembly-manifest.json",
  "type": "object",
  "required": ["schema_version", "artifact", "run_id", "generated_at", "producer", "inputs", "template_path", "output_docx", "review_decision", "placeholders", "assembly_status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact": { "const": "assembly-manifest" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "generated_at": { "$ref": "#/$defs/date_time" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "template_path": { "$ref": "#/$defs/non_empty" },
    "output_docx": { "$ref": "#/$defs/non_empty" },
    "review_decision": { "enum": ["approved", "blocked"] },
    "placeholders": { "type": "array", "items": { "$ref": "#/$defs/placeholder" } },
    "assembly_status": { "enum": ["generated", "blocked", "failed", "published"] },
    "logs": { "type": "array", "items": { "$ref": "#/$defs/log_ref" } }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{6}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "non_empty": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "required": ["agent", "version"],
      "additionalProperties": false,
      "properties": {
        "agent": { "const": "Word Layout Agent" },
        "version": { "$ref": "#/$defs/non_empty" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "path", "schema_version"],
        "additionalProperties": false,
        "properties": {
          "artifact": { "enum": ["template", "content-blocks", "diagram-manifest", "requirements", "release-decision"] },
          "path": { "$ref": "#/$defs/non_empty" },
          "schema_version": { "$ref": "#/$defs/non_empty" }
        }
      }
    },
    "placeholder": {
      "type": "object",
      "required": ["placeholder", "status", "source"],
      "additionalProperties": false,
      "properties": {
        "placeholder": { "$ref": "#/$defs/non_empty" },
        "status": { "enum": ["filled", "preserved_confirm", "review_inserted", "missing", "skipped", "failed"] },
        "source": { "$ref": "#/$defs/non_empty" },
        "message": { "type": "string" }
      }
    },
    "log_ref": {
      "type": "object",
      "required": ["kind", "path"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["placeholder-fill-log", "assembly-log", "residual-placeholder-check"] },
        "path": { "$ref": "#/$defs/non_empty" }
      }
    }
  }
}
