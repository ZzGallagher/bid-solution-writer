{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bid-solution-writer.local/schemas/requirements.schema.json",
  "title": "requirements.json",
  "type": "object",
  "required": ["schema_version", "artifact", "run_id", "generated_at", "producer", "inputs", "project", "requirements", "scoring_items", "delivery_items", "confirm_candidates", "extraction_warnings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact": { "const": "requirements" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "generated_at": { "$ref": "#/$defs/date_time" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "project": { "$ref": "#/$defs/project" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "scoring_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/scoring_item" }
    },
    "delivery_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/delivery_item" }
    },
    "confirm_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk_item" }
    },
    "extraction_warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{6}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "non_empty": { "type": "string", "minLength": 1 },
    "req_id": { "type": "string", "pattern": "^(T|P|Q|B|D)[0-9]{3}$" },
    "score_id": { "type": "string", "pattern": "^S[0-9]{3}$" },
    "producer": {
      "type": "object",
      "required": ["agent", "version"],
      "additionalProperties": false,
      "properties": {
        "agent": { "const": "Requirement Evidence Agent" },
        "version": { "$ref": "#/$defs/non_empty" },
        "model": { "type": "string" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input_ref" }
    },
    "input_ref": {
      "type": "object",
      "required": ["input_id", "path", "kind"],
      "additionalProperties": false,
      "properties": {
        "input_id": { "type": "string", "pattern": "^IN[0-9]{3}$" },
        "path": { "$ref": "#/$defs/non_empty" },
        "kind": { "enum": ["technical_requirements", "business_requirements", "scoring_table", "template", "rules", "placeholder_spec", "other"] },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/non_empty" },
        "tender_name": { "type": "string" },
        "bidder_name": { "type": "string" },
        "bidder_name_status": { "enum": ["extracted", "confirm_required", "review_required", "missing"] }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["source_file", "locator", "quote"],
      "additionalProperties": false,
      "properties": {
        "source_file": { "$ref": "#/$defs/non_empty" },
        "locator": { "type": "string" },
        "quote": { "$ref": "#/$defs/non_empty" },
        "normalized_text": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["requirement_id", "category", "title", "text", "source", "status", "risk_level", "target_sections"],
      "additionalProperties": false,
      "properties": {
        "requirement_id": { "$ref": "#/$defs/req_id" },
        "category": { "enum": ["technical_function", "technical_performance", "technical_quality", "business", "delivery"] },
        "title": { "$ref": "#/$defs/non_empty" },
        "text": { "$ref": "#/$defs/non_empty" },
        "source": { "$ref": "#/$defs/source_ref" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } },
        "mandatory": { "type": "boolean" },
        "need_diagram": { "type": "boolean" },
        "status": { "enum": ["extracted", "review_required", "confirm_required", "failed"] },
        "risk_level": { "enum": ["low", "normal", "high", "critical"] },
        "target_sections": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } },
        "related_scoring_item_ids": { "type": "array", "items": { "$ref": "#/$defs/score_id" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
      }
    },
    "scoring_item": {
      "type": "object",
      "required": ["scoring_item_id", "title", "text", "source", "score", "response_section", "status"],
      "additionalProperties": false,
      "properties": {
        "scoring_item_id": { "$ref": "#/$defs/score_id" },
        "title": { "$ref": "#/$defs/non_empty" },
        "text": { "$ref": "#/$defs/non_empty" },
        "source": { "$ref": "#/$defs/source_ref" },
        "score": { "$ref": "#/$defs/score" },
        "response_section": { "$ref": "#/$defs/non_empty" },
        "related_requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/req_id" } },
        "status": { "enum": ["extracted", "review_required", "confirm_required", "failed"] }
      }
    },
    "score": {
      "type": "object",
      "required": ["raw"],
      "additionalProperties": false,
      "properties": {
        "raw": { "$ref": "#/$defs/non_empty" },
        "value": { "type": "number", "minimum": 0 }
      }
    },
    "delivery_item": {
      "type": "object",
      "required": ["delivery_id", "name", "source", "status"],
      "additionalProperties": false,
      "properties": {
        "delivery_id": { "type": "string", "pattern": "^D[0-9]{3}$" },
        "name": { "$ref": "#/$defs/non_empty" },
        "quantity": { "type": "string" },
        "medium": { "type": "string" },
        "source": { "$ref": "#/$defs/source_ref" },
        "status": { "enum": ["extracted", "review_required", "confirm_required", "failed"] }
      }
    },
    "risk_item": {
      "type": "object",
      "required": ["item_id", "field", "reason", "status"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "string", "pattern": "^CF[0-9]{3}$" },
        "field": { "$ref": "#/$defs/non_empty" },
        "reason": { "$ref": "#/$defs/non_empty" },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["confirm_required", "review_required"] }
      }
    },
    "warning": {
      "type": "object",
      "required": ["warning_id", "message", "severity"],
      "additionalProperties": false,
      "properties": {
        "warning_id": { "type": "string", "pattern": "^EW[0-9]{3}$" },
        "message": { "$ref": "#/$defs/non_empty" },
        "severity": { "enum": ["info", "warning", "error"] },
        "source": { "$ref": "#/$defs/source_ref" }
      }
    }
  }
}
