{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bid-solution-writer.local/schemas/diagram-specs.schema.json",
  "title": "diagram-specs.json",
  "type": "object",
  "required": ["schema_version", "artifact", "run_id", "generated_at", "producer", "inputs", "diagrams"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact": { "const": "diagram-specs" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "generated_at": { "$ref": "#/$defs/date_time" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "diagrams": { "type": "array", "items": { "$ref": "#/$defs/diagram" } }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{6}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "non_empty": { "type": "string", "minLength": 1 },
    "req_id": { "type": "string", "pattern": "^(T|P|Q|B|D)[0-9]{3}$" },
    "producer": {
      "type": "object",
      "required": ["agent", "version"],
      "additionalProperties": false,
      "properties": {
        "agent": { "const": "Mermaid Agent" },
        "version": { "$ref": "#/$defs/non_empty" },
        "model": { "type": "string" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "path", "schema_version"],
        "additionalProperties": false,
        "properties": {
          "artifact": { "enum": ["requirements", "design-blueprint", "diagram-plan"] },
          "path": { "$ref": "#/$defs/non_empty" },
          "schema_version": { "$ref": "#/$defs/non_empty" }
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["diagram_id", "title", "kind", "mermaid_path", "mermaid", "source_requirement_ids", "description", "status"],
      "additionalProperties": false,
      "properties": {
        "diagram_id": { "type": "string", "pattern": "^DG[0-9]{3}$" },
        "title": { "$ref": "#/$defs/non_empty" },
        "kind": { "enum": ["architecture", "business_flow", "data_flow", "function_flow", "deployment", "security", "sequence", "other"] },
        "mermaid_path": { "$ref": "#/$defs/non_empty" },
        "mermaid": { "$ref": "#/$defs/non_empty" },
        "source_requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/req_id" } },
        "related_section_ids": { "type": "array", "items": { "type": "string", "pattern": "^SEC[0-9]{3}$" } },
        "related_module_ids": { "type": "array", "items": { "type": "string", "pattern": "^M[0-9]{3}$" } },
        "description": { "$ref": "#/$defs/non_empty" },
        "node_trace": { "type": "array", "items": { "$ref": "#/$defs/node_trace" } },
        "status": { "enum": ["generated", "review_required", "blocked"] },
        "review_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "node_trace": {
      "type": "object",
      "required": ["node_id", "label", "source_requirement_ids"],
      "additionalProperties": false,
      "properties": {
        "node_id": { "$ref": "#/$defs/non_empty" },
        "label": { "$ref": "#/$defs/non_empty" },
        "source_requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/req_id" } }
      }
    }
  }
}
