{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bid-solution-writer.local/schemas/design-blueprint.schema.json",
  "title": "design-blueprint.json",
  "type": "object",
  "required": ["schema_version", "artifact", "run_id", "generated_at", "producer", "inputs", "project_name", "architecture_layers", "modules", "sections", "diagram_plan", "coverage_map"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact": { "const": "design-blueprint" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "generated_at": { "$ref": "#/$defs/date_time" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "project_name": { "$ref": "#/$defs/non_empty" },
    "architecture_layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "diagram_plan": { "type": "array", "items": { "$ref": "#/$defs/diagram_plan" } },
    "coverage_map": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{6}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "non_empty": { "type": "string", "minLength": 1 },
    "req_id": { "type": "string", "pattern": "^(T|P|Q|B|D)[0-9]{3}$" },
    "score_id": { "type": "string", "pattern": "^S[0-9]{3}$" },
    "writing_id": { "type": "string", "pattern": "^WR[0-9]{3}$" },
    "producer": {
      "type": "object",
      "required": ["agent", "version"],
      "additionalProperties": false,
      "properties": {
        "agent": { "const": "Design Agent" },
        "version": { "$ref": "#/$defs/non_empty" },
        "model": { "type": "string" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "path", "schema_version"],
        "additionalProperties": false,
        "properties": {
          "artifact": { "enum": ["requirements", "requirements-matrix", "template-placeholder-spec", "generation-rules"] },
          "path": { "$ref": "#/$defs/non_empty" },
          "schema_version": { "$ref": "#/$defs/non_empty" }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": ["layer_id", "name", "responsibility", "source_requirement_ids"],
      "additionalProperties": false,
      "properties": {
        "layer_id": { "type": "string", "pattern": "^L[0-9]{3}$" },
        "name": { "$ref": "#/$defs/non_empty" },
        "responsibility": { "$ref": "#/$defs/non_empty" },
        "source_requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/req_id" } }
      }
    },
    "module": {
      "type": "object",
      "required": ["module_id", "name", "responsibility", "source_requirement_ids"],
      "additionalProperties": false,
      "properties": {
        "module_id": { "type": "string", "pattern": "^M[0-9]{3}$" },
        "name": { "$ref": "#/$defs/non_empty" },
        "responsibility": { "$ref": "#/$defs/non_empty" },
        "layer_ids": { "type": "array", "items": { "type": "string", "pattern": "^L[0-9]{3}$" } },
        "source_requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/req_id" } },
        "related_scoring_item_ids": { "type": "array", "items": { "$ref": "#/$defs/score_id" } },
        "suggested_diagram_ids": { "type": "array", "items": { "type": "string", "pattern": "^DG[0-9]{3}$" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["section_id", "placeholder", "title", "content_type", "source_requirement_ids", "status"],
      "additionalProperties": false,
      "properties": {
        "section_id": { "type": "string", "pattern": "^SEC[0-9]{3}$" },
        "placeholder": { "$ref": "#/$defs/non_empty" },
        "title": { "$ref": "#/$defs/non_empty" },
        "content_type": { "enum": ["copy", "generated_paragraphs", "generated_table", "dynamic_sections", "diagram_reference", "review_text", "confirm_placeholder"] },
        "source_requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/req_id" } },
        "related_scoring_item_ids": { "type": "array", "items": { "$ref": "#/$defs/score_id" } },
        "writing_requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/writing_id" } },
        "module_ids": { "type": "array", "items": { "type": "string", "pattern": "^M[0-9]{3}$" } },
        "status": { "enum": ["planned", "review_required", "confirm_required"] }
      }
    },
    "diagram_plan": {
      "type": "object",
      "required": ["diagram_id", "title", "kind", "purpose", "source_requirement_ids"],
      "additionalProperties": false,
      "properties": {
        "diagram_id": { "type": "string", "pattern": "^DG[0-9]{3}$" },
        "title": { "$ref": "#/$defs/non_empty" },
        "kind": { "enum": ["architecture", "business_flow", "data_flow", "function_flow", "deployment", "security", "sequence", "other"] },
        "purpose": { "$ref": "#/$defs/non_empty" },
        "source_requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/req_id" } },
        "related_section_ids": { "type": "array", "items": { "type": "string", "pattern": "^SEC[0-9]{3}$" } },
        "layout_hint": { "enum": ["flowchart TB", "flowchart TD", "flowchart LR", "sequenceDiagram", "other"] }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["source_id", "covered_by", "coverage_status"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^((T|P|Q|B|D|S)[0-9]{3}|WR[0-9]{3})$" },
        "covered_by": { "type": "array", "items": { "$ref": "#/$defs/coverage_ref" } },
        "coverage_status": { "enum": ["planned", "review_required", "confirm_required", "uncovered"] }
      }
    },
    "coverage_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["section", "module", "diagram", "review", "confirm"] },
        "id": { "$ref": "#/$defs/non_empty" }
      }
    }
  }
}
