{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bid-solution-writer.local/schemas/release-decision.schema.json",
  "title": "release-decision.json",
  "type": "object",
  "required": ["schema_version", "artifact", "run_id", "generated_at", "producer", "inputs", "decision", "allow_word_assembly", "quality_gates", "issues", "confirm_items", "review_items", "coverage_summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact": { "const": "release-decision" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "generated_at": { "$ref": "#/$defs/date_time" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "decision": { "enum": ["approved", "blocked"] },
    "allow_word_assembly": { "type": "boolean" },
    "quality_gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "confirm_items": { "type": "array", "items": { "$ref": "#/$defs/checklist_item" } },
    "review_items": { "type": "array", "items": { "$ref": "#/$defs/checklist_item" } },
    "coverage_summary": { "$ref": "#/$defs/coverage_summary" },
    "next_actions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{6}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "non_empty": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "required": ["agent", "version"],
      "additionalProperties": false,
      "properties": {
        "agent": { "const": "Review Gate Agent" },
        "version": { "$ref": "#/$defs/non_empty" },
        "model": { "type": "string" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "path", "schema_version"],
        "additionalProperties": false,
        "properties": {
          "artifact": { "enum": ["requirements", "requirements-matrix", "design-blueprint", "content-blocks", "diagram-specs", "diagram-manifest", "placeholder-fill-log"] },
          "path": { "$ref": "#/$defs/non_empty" },
          "schema_version": { "$ref": "#/$defs/non_empty" }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["gate_id", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "gate_id": { "type": "string", "pattern": "^G[0-9]{3}$" },
        "name": { "$ref": "#/$defs/non_empty" },
        "status": { "enum": ["passed", "warning", "failed"] },
        "message": { "type": "string" }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["artifact", "id"],
      "additionalProperties": false,
      "properties": {
        "artifact": { "enum": ["requirements.json", "requirements-matrix.json", "design-blueprint.json", "content-blocks.json", "diagram-specs.json", "diagram-manifest.json", "placeholder-fill-log.md"] },
        "id": { "$ref": "#/$defs/non_empty" },
        "path": { "type": "string" }
      }
    },
    "issue": {
      "type": "object",
      "required": ["issue_id", "severity", "category", "message", "source", "owner_agent", "suggested_action", "blocking"],
      "additionalProperties": false,
      "properties": {
        "issue_id": { "type": "string", "pattern": "^RI[0-9]{3}$" },
        "severity": { "enum": ["info", "minor", "major", "blocking"] },
        "category": { "enum": ["uncovered_requirement", "uncovered_writing_requirement", "unanswered_scoring_item", "unsupported_claim", "confirm_replaced", "review_missing", "diagram_text_mismatch", "fallback_render_unmarked", "placeholder_unresolved", "missing_source_id", "overcommitment", "schema_invalid", "other"] },
        "message": { "$ref": "#/$defs/non_empty" },
        "source": { "$ref": "#/$defs/source_ref" },
        "owner_agent": { "enum": ["Requirement Evidence Agent", "Design Agent", "Content Agent", "Mermaid Agent", "Render Validate Agent", "Word Layout Agent", "Coordinator Agent"] },
        "suggested_action": { "$ref": "#/$defs/non_empty" },
        "blocking": { "type": "boolean" }
      }
    },
    "checklist_item": {
      "type": "object",
      "required": ["item_id", "title", "source", "status"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "string", "pattern": "^(CF|RV)[0-9]{3}$" },
        "title": { "$ref": "#/$defs/non_empty" },
        "source": { "$ref": "#/$defs/source_ref" },
        "status": { "enum": ["open", "resolved", "waived"] },
        "note": { "type": "string" }
      }
    },
    "coverage_summary": {
      "type": "object",
      "required": ["requirements_total", "requirements_covered", "requirements_uncovered", "writing_requirements_total", "writing_requirements_covered", "writing_requirements_uncovered", "scoring_items_total", "scoring_items_covered"],
      "additionalProperties": false,
      "properties": {
        "requirements_total": { "type": "integer", "minimum": 0 },
        "requirements_covered": { "type": "integer", "minimum": 0 },
        "requirements_uncovered": { "type": "integer", "minimum": 0 },
        "writing_requirements_total": { "type": "integer", "minimum": 0 },
        "writing_requirements_covered": { "type": "integer", "minimum": 0 },
        "writing_requirements_uncovered": { "type": "integer", "minimum": 0 },
        "scoring_items_total": { "type": "integer", "minimum": 0 },
        "scoring_items_covered": { "type": "integer", "minimum": 0 },
        "diagram_total": { "type": "integer", "minimum": 0 },
        "diagram_assembly_allowed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
