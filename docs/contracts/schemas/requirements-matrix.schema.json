{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bid-solution-writer.local/schemas/requirements-matrix.schema.json",
  "title": "requirements-matrix.json",
  "type": "object",
  "required": ["schema_version", "artifact", "run_id", "generated_at", "producer", "inputs", "rows", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact": { "const": "requirements-matrix" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "generated_at": { "$ref": "#/$defs/date_time" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{6}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "non_empty": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "pattern": "^(T|P|Q|B|D|S)[0-9]{3}$" },
    "producer": {
      "type": "object",
      "required": ["agent", "version"],
      "additionalProperties": false,
      "properties": {
        "agent": { "const": "Requirement Evidence Agent" },
        "version": { "$ref": "#/$defs/non_empty" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "path", "schema_version"],
        "additionalProperties": false,
        "properties": {
          "artifact": { "enum": ["requirements"] },
          "path": { "$ref": "#/$defs/non_empty" },
          "schema_version": { "$ref": "#/$defs/non_empty" }
        }
      }
    },
    "row": {
      "type": "object",
      "required": ["source_id", "source_type", "title", "target_sections", "coverage_status"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "$ref": "#/$defs/evidence_id" },
        "source_type": { "enum": ["requirement", "scoring_item", "delivery_item"] },
        "title": { "$ref": "#/$defs/non_empty" },
        "target_sections": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } },
        "planned_module_ids": { "type": "array", "items": { "type": "string", "pattern": "^M[0-9]{3}$" } },
        "planned_diagram_ids": { "type": "array", "items": { "type": "string", "pattern": "^DG[0-9]{3}$" } },
        "coverage_status": { "enum": ["planned", "review_required", "confirm_required", "uncovered"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["requirements_total", "scoring_items_total", "uncovered_total"],
      "additionalProperties": false,
      "properties": {
        "requirements_total": { "type": "integer", "minimum": 0 },
        "scoring_items_total": { "type": "integer", "minimum": 0 },
        "uncovered_total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
